    <string name="action_toggleShift_normal">Disable Shift</string>
    <string name="action_toggleShift_shift">Enable Shift</string>
    <string name="action_toggleShift_capsLock">Enable Caps Lock</string>
    <string name="action_toggleShift_desc_normal">Disables any active shift modifier.</string>
    <string name="action_toggleShift_desc_shift">Replaces the next action with a shifted variant (such as an upper-case letter or alternate symbol).\nThis can also be done by drawing a circle (for tap gestures) or U (for edge gestures) on the key.\nCircle gestures can also be configured to produce numbers instead, depending on the direction.</string>
    <string name="action_toggleShift_desc_capsLock">Turns all letters upper-case until shift is disabled manually.</string>
    <string name="action_transientShift">Transient Shift</string>
    <string name="action_transientShift_desc">A gesture can be made shifted by drawing a circle (for tap gestures) or U (for edge gestures) on the key.\nGestures that require transient shift can only be made this way, not by using shift mode.\nCircle gestures can also be configured to produce numbers instead, depending on the direction.</string>
    <string name="action_toggleWordCase_up">Shift Word Up</string>
    <string name="action_toggleWordCase_down">Shift Word Down</string>
    <string name="action_toggleWordCase_desc_up">Replaces the last typed word with an "upperer-case" variant. Cycles lower-case -> Title-case, UPPER-CASE.</string>
    <string name="action_toggleWordCase_desc_down">Replaces the last typed word with an "lowerer-case" variant. Cycles UPPER-CASE -> Title-case, lower-case.</string>
    <string name="action_toggleCtrl">Toggle Control Modifier</string>
    <string name="action_toggleCtrl_desc">If enabled, the control modifier will be applied to the next typed character. This can be used to activate keyboard shortcuts intended for physical keyboards.</string>
    <string name="action_toggleAlt">Toggle Alt Modifier</string>
    <string name="action_toggleAlt_desc">If enabled, the alt modifier will be applied to the next typed character. This can be used to activate keyboard shortcuts intended for physical keyboards.</string>
