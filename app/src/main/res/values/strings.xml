    <string name="tutorial_title">Welcome to FlickBoard!</string>
    <string name="tutorial_intro">FlickBoard is a pretty unusual keyboard, so let\'s get you a quick run-down of how to use it.</string>
    <string name="tutorial_skip">SKIP</string>
    <string name="tutorial_finish">Finish</string>
    <string name="tutorial_personalization">Personalization</string>
    <string name="tutorial_handedness">Which side is your dominant hand?</string>
    <string name="tutorial_typing">Typing</string>
    <string name="tutorial_typing_instruction_center">To type the character in the middle of a key, tap it.\nTry tapping the key now, to type an o!</string>
    <string name="tutorial_typing_edge">Typing (edge)</string>
    <string name="tutorial_typing_instruction_edge">Unlike most other keyboards, FlickBoard keys have multiple characters on them.\nTo type a character at the edge of a key, swipe in that direction.\nTry swiping towards the right from the key, to type a b!</string>
    <string name="tutorial_typing_corner">Typing (corner)</string>
    <string name="tutorial_typing_instruction_corner">Characters can also appear at a corner of the key.\nTry swiping towards the bottom-left from key, to type a g!</string>
    <string name="tutorial_uppercase">Upper-case</string>
    <string name="tutorial_uppercase_instruction_center">To type an upper-case character in the middle of a key, draw a circle, starting on the key.\nTry typing an upper-case O now!</string>
    <string name="tutorial_uppercase_edge">Upper-case (edge)</string>
    <string name="tutorial_uppercase_instruction_edge">To type an upper-case character at an edge, swipe towards it and then return to where you started.\nTry typing an upper-case G now!</string>
    <string name="tutorial_complete">Great, you\'ve got the hang of it!</string>

